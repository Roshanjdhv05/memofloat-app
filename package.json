{
  "name": "memofloat",
  "productName": "MemoFloat",
  "version": "1.0.0",
  "description": "Offline-first sticky notes and reminders that live on your Windows desktop.",
  "author": "MemoFloat",
  "license": "MIT",
  "private": true,
  "main": "./out/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "node scripts/ensure-electron.mjs && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/ensure-electron.mjs && electron-vite build && playwright test -c playwright.config.ts",
    "package:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "verify:native": "node scripts/verify-native.mjs",
    "icons": "node scripts/make-icons.mjs",
    "setup": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.19",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "framer-motion": "14.2.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
